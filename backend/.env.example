# ---- Core ----
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO

# Postgres (compose uses service DNS names; host fallback uses 5433 because a
# local Postgres often occupies 5432)
DATABASE_URL=postgresql+asyncpg://kisan:kisan@localhost:5433/kisan

# Redis
REDIS_URL=redis://localhost:6379/0

# ---- Provider selection (see backend/app/providers/base.py) ----
VISION_PROVIDER=null               # null | openai
SMS_PROVIDER=console               # console | msg91
WHATSAPP_PROVIDER=null             # null | cloud_api
MANDI_PRICE_SOURCE=stub            # stub | datagov
STORAGE_PROVIDER=local             # local | s3

# Local storage path for STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/shared/data/uploads

# ---- Vision providers (leave empty; no real keys ever committed) ----
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ---- SMS / MSG91 (unused while SMS_PROVIDER=console) ----
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---- WhatsApp Cloud API (unused while WHATSAPP_PROVIDER=null) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- data.gov.in mandi prices (unused while MANDI_PRICE_SOURCE=stub) ----
DATAGOV_API_KEY=

# ---- Object storage (unused while STORAGE_PROVIDER=local) ----
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
